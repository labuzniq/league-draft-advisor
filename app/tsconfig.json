{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": ["src", "test", "scripts", "electron.vite.config.ts", "eslint.config.js"]
}
